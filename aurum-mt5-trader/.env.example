# Copy to .env (git-ignored) and fill in. Leave MT5_LOGIN empty to use the
# account the running MT5 terminal is already logged into.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optional: full path to terminal64.exe if MT5 is not auto-detected
MT5_PATH=
MT5_TIMEOUT_MS=60000

AURUM_SYMBOL=XAUUSD
AURUM_MAGIC_NUMBER=20261001
AURUM_RISK_PERCENT=1.0
AURUM_DEVIATION_POINTS=20
# Set to true only when you intend to trade a real-money account
AURUM_ALLOW_LIVE_TRADING=false

# TradingView chart screenshots in reports (needs: pip install playwright && playwright install chromium)
AURUM_CHARTS_ENABLED=true
# TradingView exchange prefix for the symbol, e.g. OANDA -> OANDA:XAUUSD
AURUM_TV_EXCHANGE=OANDA
# Optional: use an existing Chromium/Chrome binary instead of Playwright's
AURUM_CHROMIUM_PATH=

# ---- Risk guards (all on by default) ----
# News guard: no new trades from N minutes before to N minutes after high-impact events
AURUM_NEWS_GUARD=true
AURUM_NEWS_CURRENCIES=USD
AURUM_NEWS_IMPACTS=High
AURUM_NEWS_BEFORE_MINUTES=30
AURUM_NEWS_AFTER_MINUTES=30
# If the calendar can't be loaded: true = block new trades (safe), false = trade anyway
AURUM_NEWS_FAIL_CLOSED=true
# Cancel the bot's pending orders when a news blackout starts
AURUM_NEWS_CANCEL_PENDING=true
# Optional: local JSON in ForexFactory export format instead of downloading
AURUM_NEWS_CALENDAR_FILE=

# Kill zones: setups are only evaluated inside these windows (times in AURUM_KILLZONE_TIMEZONE)
AURUM_KILLZONES_ENABLED=true
AURUM_KILLZONE_TIMEZONE=Africa/Nairobi
AURUM_KILLZONES=London=10:00-12:00,NY AM=16:30-19:00
# Pending orders expire at the end of the kill zone they were placed in
AURUM_EXPIRE_AT_KILLZONE_END=true

# Daily loss guard: set below your FundedNext limit (e.g. 4 for a 5% firm limit, 2.5 for 3%)
AURUM_DAILY_LOSS_GUARD=true
AURUM_DAILY_LOSS_LIMIT_PERCENT=4.0
# Optional overall floor: e.g. 9 with your starting balance for a 10% max-loss rule
AURUM_MAX_TOTAL_LOSS_PERCENT=
AURUM_INITIAL_BALANCE=
# Broker server hour when the trading day resets (FundedNext: check your account rules)
AURUM_DAY_RESET_HOUR=0

# Dashboard API (python src/api/server.py). Keep the host on 127.0.0.1 unless you set a token.
AURUM_API_HOST=127.0.0.1
AURUM_API_PORT=8000
# If set, POST /api/control and /api/credentials require: Authorization: Bearer <token>
AURUM_API_TOKEN=
